# PostgreSQL connection string (Supabase / Neon / Local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/catatan_harian

# Secret untuk menandatangani JWT — ganti dengan string acak yang panjang di production
JWT_ACCESS_SECRET=ubah-ke-string-acak-yang-sangat-panjang-dan-rahasia
JWT_REFRESH_SECRET=ubah-lagi-ke-string-acak-lain-yang-berbeda

# Umur token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Port server
PORT=3000

# Origin frontend yang diizinkan CORS (pisahkan dengan koma kalau lebih dari satu)
CORS_ORIGIN=http://localhost:5173,http://localhost:3636
